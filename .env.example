# Copy to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored; this file is committed. Never put real credentials here.
#
# Every key below is required - core.config.Settings declares no defaults, so
# a missing one raises ValidationError the first time get_settings() is called.

# --- Database ---------------------------------------------------------------
# Special characters in DB_USER and DB_PASSWORD are fine: Settings.DB_URL
# percent-encodes both before building the connection string.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=url_short_db

# --- Service ----------------------------------------------------------------
# Public origin this service is reached on, used to build short_url in
# responses. A trailing slash is tolerated. No host is hardcoded in the code.
BASE_URL=http://localhost:8000
